<Page
    x:Class="Sefirah.Views.Settings.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Sefirah.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Sefirah.Helpers"
    xmlns:items="using:Sefirah.Data.Items"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Sefirah.Data.Models"
    x:Name="DevicePage"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:ConnectionStatusBrushConverter x:Key="ConnectionStatusBrushConverter" />
        <x:Double x:Key="BreadcrumbBarChevronFontSize">17</x:Double>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <converters:CountToVisibilityConverter x:Key="InverseCountToVisibilityConverter" Inverse="True" />
    </Page.Resources>


    <ScrollViewer Padding="0,0,40,0">
        <StackPanel Spacing="4">
            <!--  Breadcrumb Navigation with Button  -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <BreadcrumbBar x:Name="BreadcrumbBar" Grid.Column="0">
                    <BreadcrumbBar.ItemTemplate>
                        <DataTemplate x:DataType="items:BreadcrumbBarItemModel">
                            <BreadcrumbBarItem AutomationProperties.Name="{Binding Name}" Content="{Binding}">
                                <BreadcrumbBarItem.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            FontSize="28"
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}" />
                                    </DataTemplate>
                                </BreadcrumbBarItem.ContentTemplate>
                            </BreadcrumbBarItem>
                        </DataTemplate>
                    </BreadcrumbBar.ItemTemplate>
                </BreadcrumbBar>
                <Button
                    Grid.Column="1"
                    Click="OpenDeviceDiscovery">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xECC8;" />
                        <TextBlock Text="{helpers:ResourceString Name=AvailableDevices/Title}" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Margin="0,4,0,20" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="5">
                    <TextBlock Text="{x:Bind ViewModel.ConnectionSummary, Mode=OneWay}" FontWeight="SemiBold" />
                    <TextBlock Text="{helpers:ResourceString Name=DevicesOverviewHint}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="{helpers:ResourceString Name=ConnectAllDevices}" Command="{x:Bind ViewModel.ConnectAllDevicesCommand}" VerticalAlignment="Center" />
            </Grid>

            <ItemsRepeater ItemsSource="{x:Bind ViewModel.PairedDevices, Mode=OneWay}">
                <ItemsRepeater.Layout><StackLayout Spacing="10" /></ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:PairedDevice">
                        <Border Padding="20,18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <FontIcon FontSize="26" Glyph="{x:Bind DeviceIcon, Mode=OneWay}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind DeviceDescription, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                </StackPanel>
                                <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="12" Padding="10,5" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{x:Bind ConnectionStatus, Mode=OneWay, Converter={StaticResource ConnectionStatusBrushConverter}}" />
                                        <TextBlock Text="{x:Bind ConnectionStatusText, Mode=OneWay}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <Button Grid.Column="3" VerticalAlignment="Center" MinWidth="110" Content="{x:Bind ConnectionActionText, Mode=OneWay}"
                                    Tag="{x:Bind}" Click="ToggleConnection_Click" />
                                <Button Grid.Column="4" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="8"
                                    AutomationProperties.Name="{helpers:ResourceString Name=DeviceActions}">
                                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="{helpers:ResourceString Name=ViewDeviceDetails}" Tag="{x:Bind}" Click="ViewDetails_Click" />
                                            <MenuFlyoutItem Text="{helpers:ResourceString Name=DeviceSettings}" Tag="{x:Bind}" Click="DeviceSettings_Click" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="{helpers:ResourceString Name=Remove}" Tag="{x:Bind}" Click="RemoveDevice_Click" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!--  Empty State  -->
            <StackPanel
                Margin="0,32"
                HorizontalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.PairedDevices.Count, Mode=OneWay, Converter={StaticResource InverseCountToVisibilityConverter}}">
                <FontIcon
                    FontSize="32"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE8EA;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{helpers:ResourceString Name=NoPairedDevices}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
